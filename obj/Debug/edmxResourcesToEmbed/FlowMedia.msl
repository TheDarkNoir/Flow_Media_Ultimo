        <MappingFragment StoreEntitySet="Multa">
          <ScalarProperty Name="codigo_multa" ColumnName="codigo_multa" />
          <ScalarProperty Name="fecha_multa" ColumnName="fecha_multa" />
          <ScalarProperty Name="descripcion_multa" ColumnName="descripcion_multa" />
          <ScalarProperty Name="monto_multa" ColumnName="monto_multa" />
          <ScalarProperty Name="estado_multa" ColumnName="estado_multa" />
          <ScalarProperty Name="codigo_devolucion" ColumnName="codigo_devolucion" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Producto_Multimedia">
      <EntityTypeMapping TypeName="FlowMediaModel.Producto_Multimedia">
