<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="FlowMediaModelStoreContainer" CdmEntityContainer="FlowMediaEntities">
    <EntitySetMapping Name="Carrito_Compra">
      <EntityTypeMapping TypeName="FlowMediaModel.Carrito_Compra">
        <MappingFragment StoreEntitySet="Carrito_Compra">
          <ScalarProperty Name="codigo_carrito" ColumnName="codigo_carrito" />
