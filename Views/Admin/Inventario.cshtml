@model List<FlowMediaWebMVC.Inventario>
@{
    ViewBag.Title = "INVENTARIO / BODEGA";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card-panel">
    <div class="controls">
        <div class="controls-left">
            <a href="@Url.Action("Inventario", "Admin")" class="btn-outline">REFRESCAR</a>
            <a href="@Url.Action("CrearInventario", "Admin")" class="btn-primary">+ AGREGAR INVENTARIO</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table-admin">
        <thead>
            <tr>
                <th>CÓDIGO</th>
                <th>CANTIDAD</th>
                <th>FECHA INGRESO</th>
                <th>UBICACIÓN</th>
                <th>ACCIONES</th>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
            <tr>
                <td>@item.codigo_inventario</td>
                <td>@item.cantidad_inventario unidades</td>
                <td>@item.fecha_ingreso_inventario</td>
                <td>@item.ubicacion_producto_inventario</td>
                <td>
                    <a href="@Url.Action("EditarInventario", "Admin", new { id = item.codigo_inventario })" class="btn-warning" style="padding: 6px 12px; display: inline-block;">Editar</a>
                    <button onclick="eliminarInventario(@item.codigo_inventario)" class="btn-danger" style="padding: 6px 12px;">Eliminar</button>
                </td>
            </tr>
                }
            }
            else
            {
            <tr>
                <td colspan="5">No hay registros de inventario.</td>
            </tr>
            }
        </tbody>
    </table>
</div>

@section scripts {
    <script>
        function eliminarInventario(id) {
            if (confirm('¿Estás seguro de eliminar este inventario? Esta acción no se puede deshacer.')) {
                $.ajax({
                    url: '@Url.Action("EliminarInventario", "Admin")',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Error al comunicarse con el servidor');
                    }
                });
            }
        }
    </script>
}