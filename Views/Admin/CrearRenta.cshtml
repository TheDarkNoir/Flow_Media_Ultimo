@model FlowMediaWebMVC.Renta
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "CREAR RENTA";
}

<div class="modal-card">
    <div class="modal-header">
        <h2>📋 NUEVA RENTA</h2>
        <a href="@Url.Action("Rentas", "Admin")" class="btn-cancel" style="color: #111; text-decoration: none;">✖ CERRAR</a>
    </div>

    @using (Html.BeginForm("CrearRenta", "Admin", FormMethod.Post))
    {
    @Html.AntiForgeryToken()

    <div class="modal-body">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="form-row">
            <div class="form-group">
                <label for="fecha_renta">Fecha de Renta *</label>
                <input type="date" name="fecha_renta" id="fecha_renta" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                @Html.ValidationMessageFor(m => m.fecha_renta)
            </div>

            <div class="form-group">
                <label for="fecha_devolucion_renta">Fecha de Devolución *</label>
                <input type="date" name="fecha_devolucion_renta" id="fecha_devolucion_renta" class="form-control" value="@DateTime.Now.AddDays(3).ToString("yyyy-MM-dd")" required />
                @Html.ValidationMessageFor(m => m.fecha_devolucion_renta)
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="estado_renta">Estado *</label>
                <select name="estado_renta" id="estado_renta" class="form-control" required>
                    <option value="">-- Seleccione un estado --</option>
                    <option value="Activa">Activa</option>
                    <option value="Devuelta">Devuelta</option>
                    <option value="Vencida">Vencida</option>
                </select>
                @Html.ValidationMessageFor(m => m.estado_renta)
            </div>

            <div class="form-group">
                <label for="numero_identificacion_usuario">Usuario *</label>
                <select name="numero_identificacion_usuario" id="numero_identificacion_usuario" class="form-control" required>
                    @foreach (var usuario in ViewBag.Usuarios)
                        {
                    <option value="@usuario.Value">@usuario.Text</option>
                        }
                </select>
                @Html.ValidationMessageFor(m => m.numero_identificacion_usuario)
            </div>
        </div>

        <div class="form-group">
            <label>Productos a Rentar</label>
            <div id="productos-container">
                <div class="producto-row form-row">
                    <div class="form-group" style="flex: 2;">
                        <select name="productos" class="form-control">
                            @foreach (var producto in ViewBag.Productos)
                                {
                            <option value="@producto.Value">@producto.Text</option>
                                }
                        </select>
                    </div>
                    <div class="form-group" style="flex: 0.5;">
                        <input type="number" name="cantidades" placeholder="Cantidad" class="form-control" value="1" min="1" />
                    </div>
                    <div class="form-group" style="flex: 0.2;">
                        <button type="button" class="btn-danger" onclick="$(this).closest('.producto-row').remove()">✖</button>
                    </div>
                </div>
            </div>
            <button type="button" class="btn-outline" onclick="agregarProducto()" style="margin-top: 10px;">+ Agregar Producto</button>
        </div>
    </div>

    <div class="modal-footer">
        <a href="@Url.Action("Rentas", "Admin")" class="btn-cancel" style="text-decoration: none;">CANCELAR</a>
        <button type="submit" class="btn-primary">GUARDAR RENTA</button>
    </div>
    }
</div>

@section scripts {
    <script>
        function agregarProducto() {
            var container = document.getElementById('productos-container');
            var newRow = document.createElement('div');
            newRow.className = 'producto-row form-row';
            newRow.innerHTML = `
                <div class="form-group" style="flex: 2;">
                    <select name="productos" class="form-control">
                        @foreach (var producto in ViewBag.Productos)
                        {
                            <option value="@producto.Value">@producto.Text</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="flex: 0.5;">
                    <input type="number" name="cantidades" placeholder="Cantidad" class="form-control" value="1" min="1" />
                </div>
                <div class="form-group" style="flex: 0.2;">
                    <button type="button" class="btn-danger" onclick="$(this).closest('.producto-row').remove()">✖</button>
                </div>
            `;
            container.appendChild(newRow);
        }

        // Validar que la fecha de devolución sea posterior
        $('#fecha_devolucion_renta').change(function() {
            var fechaRenta = new Date($('#fecha_renta').val());
            var fechaDevolucion = new Date($(this).val());

            if (fechaDevolucion <= fechaRenta) {
                alert('La fecha de devolución debe ser posterior a la fecha de renta');
                $(this).val($('#fecha_renta').val());
            }
        });
    </script>
}