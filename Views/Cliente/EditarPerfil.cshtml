@model FlowMediaWebMVC.Usuario

@{
    ViewBag.Title = "Editar Perfil";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<link href="@Url.Content("~/EstilosOriginales/perfil.css")" rel="stylesheet" />
<link href="@Url.Content("~/EstilosOriginales/editarperfil.css")" rel="stylesheet" />

<div class="perfil-page">
    <aside class="perfil-sidebar">
        <div class="perfil-avatar">
            <div class="avatar-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cfe8f5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div class="perfil-name">@((Model != null) ? Model.nombre_usuario : "Usuario Flow")</div>
            <div class="perfil-role">@((Model != null && !string.IsNullOrEmpty(Model.tipo_usuario)) ? Model.tipo_usuario.ToUpper() : "USER")</div>
        </div>

        <nav class="perfil-nav">
            <a class="nav-item" href="@Url.Action("Pedidos","Usuario")">🕘 Mis Rentas</a>
            <a class="nav-item" href="@Url.Action("Compras","Usuario")">🛍️ Mis Compras</a>
            <a class="nav-item active" href="@Url.Action("PerfilCliente","Usuario")">⚙️ Mis Datos</a>
        </nav>
    </aside>

    <main class="perfil-main">
        <div class="profile-card editar-card">

            <div class="editar-avatar-section">
                <div class="editar-avatar-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <h2 class="editar-title">Mis datos</h2>
            </div>

            @using (Html.BeginForm("EditarPerfil", "Usuario", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="numero_identificacion_usuario" value="@(Model != null ? Model.numero_identificacion_usuario.ToString() : "")" />
                <input type="hidden" name="tipo_identificacion_usuario" value="@(Model != null ? Model.tipo_identificacion_usuario : "")" />
                <input type="hidden" name="tipo_usuario" value="@(Model != null ? Model.tipo_usuario : "Cliente")" />

                <div class="editar-form-grid">
                    <div class="editar-field">
                        <label class="editar-label">NOMBRE COMPLETO</label>
                        <input type="text" name="nombre_usuario" class="editar-input" value="@(Model != null ? Model.nombre_usuario : "")" required />
                    </div>
                    <div class="editar-field">
                        <label class="editar-label">E-MAIL</label>
                        <input type="email" name="email_usuario" class="editar-input" value="@(Model != null ? Model.email_usuario : "")" required />
                    </div>
                    <div class="editar-field">
                        <label class="editar-label">TELÉFONO</label>
                        <input type="text" name="telefono_usuario" class="editar-input" value="@(Model != null ? Model.telefono_usuario.ToString() : "")" required />
                    </div>
                    <div class="editar-field">
                        <label class="editar-label">DIRECCIÓN</label>
                        <input type="text" name="direccion_usuario" class="editar-input" value="@(Model != null ? Model.direccion_usuario : "")" required />
                    </div>
                    <div class="editar-field">
                        <label class="editar-label">NUEVA CONTRASEÑA (OPCIONAL)</label>
                        <input type="password" name="nueva_contraseña" id="nuevaPassword" class="editar-input" placeholder="Dejar en blanco para no cambiar" />
                    </div>
                    <div class="editar-field">
                        <label class="editar-label">CONFIRMAR NUEVA CONTRASEÑA</label>
                        <input type="password" name="confirmar_contraseña" id="confirmarPassword" class="editar-input" placeholder="Confirmar nueva contraseña" />
                    </div>
                </div>

                <div class="editar-buttons">
                    <a href="@Url.Action("PerfilCliente","Usuario")" class="btn-cancelar">CANCELAR</a>
                    <button type="submit" class="btn-guardar">GUARDAR CAMBIOS</button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <p style="color:red; text-align:center; margin-top:12px;">@TempData["Error"]</p>
            }
            @if (TempData["Mensaje"] != null)
            {
                <p style="color:green; text-align:center; margin-top:12px;">@TempData["Mensaje"]</p>
            }
        </div>
    </main>
</div>

@section scripts {
    <script>
        (function () {
            var form = document.querySelector('.editar-card form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var nueva = document.getElementById('nuevaPassword').value;
                    var confirmar = document.getElementById('confirmarPassword').value;
                    if (nueva && nueva !== confirmar) {
                        e.preventDefault();
                        alert('Las contraseñas no coinciden.');
                    }
                });
            }
        })();
    </script>
}

